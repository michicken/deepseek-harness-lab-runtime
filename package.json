{
  "name": "deepseek-harness-lab-runtime",
  "version": "0.2.0",
  "description": "Durable long-running autonomous mission runtime plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michicken/deepseek-harness-lab-runtime.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.3",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-group": "^1.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "0.1.5-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.1.5-rc.3",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.3",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "assets/*.txt",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
